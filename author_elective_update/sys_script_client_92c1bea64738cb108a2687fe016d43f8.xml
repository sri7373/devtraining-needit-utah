        <messages/>
        <name>Require Config Notes on Task 3 Closure</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    // Don't run on form load
    if (isLoading) return;
    
    // Only applies to Task 3 - Equipment Configuration
    var taskName = g_form.getValue('short_description');
    if (taskName.indexOf('Equipment Configuration - Configure the equipment') === -1) return;
    
    // If fulfiller is trying to close the task
    if (newValue === '3') { // 3 = Closed Complete
        var configNotes = g_form.getValue('work_notes');
        if (!configNotes) {
            g_form.showFieldMsg('work_notes', 'Configuration Notes must be filled before closing this task.', 'error');
            // Revert state back to open
            g_form.setValue('state', oldValue);
        }
    }
}]]></script>
